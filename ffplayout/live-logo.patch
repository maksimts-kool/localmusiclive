+/// How often to look at the logo file's modification time; once a frame at
+/// 30 fps, so a card the panel animates comes through at full frame rate.
+const LIVE_LOGO_CHECK: Duration = Duration::from_millis(15);
+
+/// Reloads the logo when its file changes, so another program can update the
+/// picture while a clip plays (localmusiclive patch: on-screen song cards).
+/// Writers should replace the file atomically (write elsewhere, then rename).
+///
+/// Decoding and scaling the picture happens on a helper thread: done inside the
+/// encode loop it would hold up frames and make the stream stutter while the
+/// card animates. The new picture goes on the first frame after it is ready.
+struct LiveLogo {
+    config: LogoConfig,
+    width: u32,
+    height: u32,
+    modified: Option<SystemTime>,
+    next_check: Instant,
+    loading: Option<mpsc::Receiver<(Option<SystemTime>, Result<LogoOverlay>)>>,
+}
+
+impl LiveLogo {
+    fn new(config: &LogoConfig, width: u32, height: u32, loaded: bool) -> Self {
+        Self {
+            config: config.clone(),
+            width,
+            height,
+            modified: loaded.then(|| Self::modified(&config.path)).flatten(),
+            next_check: Instant::now() + LIVE_LOGO_CHECK,
+            loading: None,
+        }
+    }
+
+    fn modified(path: &str) -> Option<SystemTime> {
+        std::fs::metadata(path).and_then(|meta| meta.modified()).ok()
+    }
+
+    fn refresh(&mut self, logo: &mut Option<LogoOverlay>) {
+        if let Some(loading) = &self.loading {
+            match loading.try_recv() {
+                Ok((modified, result)) => {
+                    self.loading = None;
+                    match result {
+                        Ok(overlay) => {
+                            *logo = Some(overlay);
+                            self.modified = modified;
+                        }
+                        Err(error) => trace!("live logo reload failed: {error:#}"),
+                    }
+                }
+                Err(mpsc::TryRecvError::Empty) => return,
+                Err(mpsc::TryRecvError::Disconnected) => self.loading = None,
+            }
+        }
+
+        let now = Instant::now();
+        if now < self.next_check {
+            return;
+        }
+        self.next_check = now + LIVE_LOGO_CHECK;
+
+        let modified = Self::modified(&self.config.path);
+        if modified.is_none() || modified == self.modified {
+            return;
+        }
+        let (tx, rx) = mpsc::channel();
+        let (config, width, height) = (self.config.clone(), self.width, self.height);
+        let spawned = thread::Builder::new().name("live-logo".into()).spawn(move || {
+            let _ = tx.send((modified, LogoOverlay::load(&config, width, height)));
+        });
+        match spawned {
+            Ok(_) => self.loading = Some(rx),
+            Err(error) => trace!("live logo reload thread failed: {error}"),
+        }
+    }
+}
