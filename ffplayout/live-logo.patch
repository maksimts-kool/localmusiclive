+/// How often to look at the logo file; about once a frame at 30 fps, so a
+/// picture another program animates comes through at full frame rate.
+const LIVE_LOGO_CHECK: Duration = Duration::from_millis(15);
+
+/// Reloads the logo when its file changes, so another program can update the
+/// picture while a clip plays (localmusiclive patch: on-screen song cards).
+/// Writers should replace the file atomically (write elsewhere, then rename).
+///
+/// The check runs on its own thread and hands changes to the channel's logo
+/// control, which prepares the new picture off the video thread and swaps it
+/// in, without a fade, once it is ready. Stock ffplayout only notices a new
+/// file at the next clip or when the logo settings are saved.
+struct LiveLogo {
+    stop: Arc<AtomicBool>,
+}
+
+impl LiveLogo {
+    fn start(config: &OutputConfig) -> Option<Self> {
+        let logo = config.logo.clone().filter(|logo| logo.opacity > 0.0)?;
+        let control = config.logo_control.clone();
+        let preparation = config.graphics_preparation.clone();
+        let canvas = (config.width, config.height);
+        let channel = config.channel_id;
+        let stop = Arc::new(AtomicBool::new(false));
+        let stopped = stop.clone();
+
+        let spawned = thread::Builder::new()
+            .name("live-logo".into())
+            .spawn(move || {
+                let revision = |path: &str| {
+                    fs::metadata(path)
+                        .and_then(|meta| Ok((meta.len(), meta.modified()?)))
+                        .ok()
+                };
+                let mut seen: Option<(u64, SystemTime)> = revision(&logo.path);
+
+                while !stopped.load(Ordering::Relaxed) {
+                    thread::sleep(LIVE_LOGO_CHECK);
+                    let current = revision(&logo.path);
+
+                    if current.is_none() || current == seen {
+                        continue;
+                    }
+                    seen = current;
+
+                    if let Err(error) =
+                        control.request(Some(logo.clone()), canvas, channel, preparation.clone())
+                    {
+                        debug!("live logo reload failed: {error:#}");
+                    }
+                }
+            });
+
+        match spawned {
+            Ok(_) => Some(Self { stop }),
+            Err(error) => {
+                debug!("live logo watcher not started: {error}");
+                None
+            }
+        }
+    }
+}
+
+impl Drop for LiveLogo {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+    }
+}
