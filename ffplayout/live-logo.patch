+/// How often to look at the logo file; about once a frame at 30 fps, so a
+/// picture another program animates comes through at full frame rate.
+const LIVE_LOGO_CHECK: Duration = Duration::from_millis(15);
+static LIVE_LOGO_IDS: AtomicU64 = AtomicU64::new(0);
+
+/// Shows changes to the logo file while a clip plays, so another program can
+/// update the picture (localmusiclive patch: on-screen song cards). Writers
+/// should replace the file atomically (write elsewhere, then rename).
+///
+/// A helper thread notices a change, decodes the new picture and leaves it for
+/// the next video frame, which shows it as the logo's current frame, the way an
+/// animated logo advances. Nothing is decoded on the video thread and the logo
+/// layer itself stays as it is. Stock ffplayout only picks up a changed file at
+/// the next clip or when the logo settings are saved.
+struct LiveLogo {
+    stop: Arc<AtomicBool>,
+    latest: Arc<Mutex<Option<Arc<LogoOverlay>>>>,
+}
+
+impl LiveLogo {
+    fn start(config: &OutputConfig) -> Option<Self> {
+        let logo = config.logo.clone().filter(|logo| logo.opacity > 0.0)?;
+        let (width, height) = (config.width, config.height);
+        let stop = Arc::new(AtomicBool::new(false));
+        let latest = Arc::new(Mutex::new(None));
+        let (stopped, ready) = (stop.clone(), latest.clone());
+        let copy = std::env::temp_dir().join(format!(
+            "ffplayout-live-logo-{}-{}.png",
+            std::process::id(),
+            LIVE_LOGO_IDS.fetch_add(1, Ordering::Relaxed)
+        ));
+
+        let spawned = thread::Builder::new()
+            .name("live-logo".into())
+            .spawn(move || {
+                let revision = |path: &str| {
+                    fs::metadata(path)
+                        .and_then(|meta| Ok((meta.len(), meta.modified()?)))
+                        .ok()
+                };
+                let mut seen: Option<(u64, SystemTime)> = revision(&logo.path);
+
+                while !stopped.load(Ordering::Relaxed) {
+                    thread::sleep(LIVE_LOGO_CHECK);
+                    let current = revision(&logo.path);
+
+                    if current.is_none() || current == seen {
+                        continue;
+                    }
+
+                    match Self::decode(&logo, &copy, width, height) {
+                        Ok(surface) => {
+                            seen = current;
+                            *ready.lock().unwrap_or_else(PoisonError::into_inner) =
+                                Some(Arc::new(surface));
+                        }
+                        // Caught mid-replacement; the next check tries again.
+                        Err(error) => debug!("live logo not loaded: {error:#}"),
+                    }
+                }
+
+                let _ = fs::remove_file(&copy);
+            });
+
+        match spawned {
+            Ok(_) => Some(Self { stop, latest }),
+            Err(error) => {
+                debug!("live logo watcher not started: {error}");
+                None
+            }
+        }
+    }
+
+    /// Decodes a private copy: FFmpeg's image reader opens a path more than
+    /// once, and the file may be replaced in between.
+    fn decode(logo: &LogoConfig, copy: &Path, width: u32, height: u32) -> Result<LogoOverlay> {
+        let bytes = fs::read(&logo.path).context("reading logo")?;
+        ensure!(
+            !logo.path.to_lowercase().ends_with(".png")
+                || bytes.len() > 12 && &bytes[bytes.len() - 8..bytes.len() - 4] == b"IEND",
+            "logo file is incomplete"
+        );
+        fs::write(copy, &bytes).context("copying logo")?;
+        let style = LogoStyle {
+            scale: logo.scale.clone(),
+            opacity: logo.opacity,
+            position: logo.position.clone(),
+        };
+        let path = copy.to_string_lossy();
+        let input = open_media_input(&path).context("opening logo")?;
+        let surface = PreparedLogoOverlay::from_input(&style, input, &logo.path, width, height)?;
+
+        Ok(LogoOverlay(Arc::new(surface), None))
+    }
+
+    fn take(&self) -> Option<Arc<LogoOverlay>> {
+        self.latest.try_lock().ok()?.take()
+    }
+}
+
+impl Drop for LiveLogo {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+    }
+}
