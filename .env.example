# Copy to .env and fill in. `.env` is git-ignored.

# --- Watching ----------------------------------------------------------------
# The stream is served on your network, no streaming service involved: open
# http://<this Mac's IP>:8090 on the TV (or /channel.m3u in an IPTV app).
WATCH_PORT=8090
# 0.0.0.0 makes the watch page reachable from the network (the TV). It serves
# only the stream; the panel and ffplayout stay on BIND_ADDRESS.
WATCH_BIND_ADDRESS=0.0.0.0
# Delay: viewers are about 2-3 segments behind live. 2 s is the shortest
# (ffplayout's keyframe interval); raise both if a TV on weak Wi-Fi stutters.
HLS_SEGMENT_SECONDS=2
HLS_LIST_SIZE=10
# Optional: push to an RTMP server instead (an Owncast server, a platform),
# stream key included, e.g. rtmp://owncast.local:1935/live/<key>.
# While set, the watch page has no stream: ffplayout has one output at a time.
RTMP_URL=

# --- Output ----------------------------------------------------------------
# 720p30 at 3000 kbit/s is comfortable for software x264 on a Mac.
# For 1080p30 use 1920x1080 and ~5000 kbit/s.
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=30
VIDEO_BITRATE_KBPS=3000
AUDIO_BITRATE_KBPS=128
X264_PRESET=veryfast

# --- ffplayout admin login (also used by the panel) ------------------------
FFPLAYOUT_USER=admin
FFPLAYOUT_PASSWORD=change-me
FFPLAYOUT_MAIL=admin@localhost.invalid

# --- Host --------------------------------------------------------------------
# Folder with your clips; mounted at /media in both containers.
MEDIA_DIR=./media
# Day boundaries and the on-screen clock follow this zone.
TZ=Europe/Tallinn
# 127.0.0.1 keeps both web UIs private to this machine. Use 0.0.0.0 for LAN access.
BIND_ADDRESS=127.0.0.1
PANEL_PORT=8080
FFPLAYOUT_PORT=8787
FFPLAYOUT_VERSION=2.6.0
LIBRARY_RESCAN_MINUTES=5

# --- YouTube search & download (panel → YouTube tab) -------------------------
# Skip videos longer than this (compilations, hour-long loops).
YOUTUBE_MAX_MINUTES=20
# Downloads take the best video and audio YouTube has. Set e.g. 1080 to cap the
# resolution (bigger files and AV1/VP9 4K decoding cost CPU while streaming).
YOUTUBE_MAX_HEIGHT=0
# Update yt-dlp each time the panel starts; YouTube breaks old versions.
YTDLP_AUTO_UPDATE=true
